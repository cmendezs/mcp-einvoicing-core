<?xml version="1.0"?>
<gc:Codelist xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
  <gc:Identification>
    <gc:ShortName Lang="en">Subtotal Type</gc:ShortName>
    <gc:Version>2022-01</gc:Version>
  </gc:Identification>
  <gc:ColumnSet>
    <gc:Column Id="id" Use="required">
      <gc:ShortName>Identifier</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Column Id="name" Use="optional">
      <gc:ShortName>Name</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Column Id="description" Use="optional">
      <gc:ShortName>Description</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Key Id="idKey">
      <gc:ColumnRef Ref="id"/>
    </gc:Key>
  </gc:ColumnSet>
  <gc:SimpleCodeList>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>PerTP</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Aggregated per Transport Profile</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>PerSP-DT-PR</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Aggregated per Service Provider, Dataset Type ID and Process ID</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>PerSP-DT-PR-CC</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Aggregated per Service Provider, Dataset Type ID, Process ID, Sender Country and Receiver Country</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
  </gc:SimpleCodeList>
</gc:Codelist>
